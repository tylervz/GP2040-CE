# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = tab
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,yml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[configs/**.h]
indent_style = space
insert_final_newline = false

[configs/**.md]
insert_final_newline = false

[configs/**CMakeLists.txt]
insert_final_newline = false

[headers/**.h]
indent_style = tab

# To avoid disrupting pull requests, use the existing style for these .h files
[{headers/addonmanager.h,headers/bitmaps.h,headers/buttonlayouts.h,headers/config_utils.h,headers/configmanager.h,headers/drivermanager.h,headers/gamepad/GamepadAuxState.h}]
indent_style = space
indent_size = 4

# To avoid disrupting pull requests, use the existing style for these .h files
[{headers/gp2040.h,headers/gp2040aux.h,headers/gpaddon.h,headers/gpconfig.h,headers/gpdriver.h,headers/helper.h}]
indent_style = space
indent_size = 4

# To avoid disrupting pull requests, use the existing style for these .h files
[{headers/layoutmanager.h,headers/peripheralmanager.h,headers/songs.h,headers/system.h,headers/usbhostmanager.h,headers/usblistener.h}]
indent_style = space
indent_size = 4

# To avoid disrupting pull requests, use the existing style for these .h files
[headers/tusb_config.h]
indent_style = space
indent_size = 2

# To avoid disrupting pull requests, use the existing style for these .h files
[headers/drivers/**.h]
indent_style = space
indent_size = 4

# To avoid disrupting pull requests, keep using tabs for these .h files
[{headers/drivers/astro/AstroDescriptors.h,headers/drivers/hid/HIDDescriptors.h,headers/drivers/keyboard/KeyboardDescriptors.h,headers/drivers/mdmini/MDMiniDescriptors.h,headers/drivers/neogeo/NeoGeoDescriptors.h}]
indent_style = tab

# To avoid disrupting pull requests, keep using tabs for these .h files
[{headers/drivers/shared/driverhelper.h,headers/drivers/switch/SwitchDescriptors.h,headers/drivers/xboxog/XboxOriginalDescriptors.h,headers/drivers/xboxog/xid/xid_steelbattalion.h}]
indent_style = tab

# To avoid disrupting pull requests, use the existing style for these .h files
[headers/display/**.h]
indent_style = space
indent_size = 4

[headers/display/fonts/**.h]
indent_style = tab

# To avoid disrupting pull requests, use the existing style for these .h files
[headers/interfaces/**.h]
indent_style = space
indent_size = 4

[*.scss]
end_of_line = lf

[*.{js,jsx,ts,tsx}]
quote_type = single

[{package-lock.json,CMakeLists.txt,www/public/manifest.json}]
indent_style = space
indent_size = 2

[src/**.c]
indent_style = space
indent_size = 4

[pico_sdk_import.cmake]
indent_style = space
indent_size = 4

[modules/**.cmake]
indent_style = space
insert_final_newline = false

[proto/**.proto]
indent_style = space
indent_size = 4
